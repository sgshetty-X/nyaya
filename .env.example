# Nyaya Legal Aid & Case Preparation Platform Environment Configuration

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Injected at runtime by AI Studio.
APP_URL="http://localhost:3000"

# AI Configuration
AI_PROVIDER="gemini"
AI_MODEL="gemini-2.5-flash"

# Database Configuration (for standalone / production deployment with PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nyaya"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"

# Storage Configuration
STORAGE_BUCKET="nyaya-legal-documents"

# Node Environment
NODE_ENV="development"
PORT="3000"
